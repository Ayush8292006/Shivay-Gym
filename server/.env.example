# Copy this file to .env and fill in the values.

# ---- Server ----
PORT=8787
# Secret shared with the admin app (Settings -> WhatsApp Delivery -> Server API key).
# Use a long random value, e.g. run: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string
# Which websites may call this server (comma separated). * = any.
ALLOWED_ORIGINS=http://localhost:5173
TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91

# ---- WhatsApp Business Cloud API (Meta) ----
# Leave these empty to run in DRY RUN mode (messages are logged, not sent).
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v23.0
# Any text you choose; paste the same value in Meta -> WhatsApp -> Configuration -> Webhook
WA_WEBHOOK_VERIFY_TOKEN=shivay-webhook-verify
# App secret (Meta app -> Settings -> Basic). Used to verify webhook signatures.
WA_APP_SECRET=

# ---- Scheduler ----
SCHEDULER_ENABLED=true
# If the server was off at the scheduled time, still send if it starts within this many minutes.
SCHEDULER_CATCHUP_MINUTES=120
# Pause between messages (ms) to stay inside WhatsApp rate limits.
SEND_DELAY_MS=400

# Safety net: if set, EVERY message goes to this number no matter what the app says.
FORCE_TEST_NUMBER=
